# Ingenic XBurst MXU2 (128-bit SIMD) instruction set
#
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Reference:
#       XBurst Instruction Set Architecture MXU2 Programming Manual,
#       revision 2.16

&r2                 vd vs df
&r3                 vd vs vt df
&r4                 vd vs vt vr
&i                  vd vs imm df
&ldst               vd base offset
&ldst_x             vd base index
&b                  vs offset df
&li                 vd imm df
&gpr                rt vr imm df
&fpr                ft vr imm df
&cr                 rt cr

%ldst_a             11:s10 !function=times_16
%fdf                0:1 !function=plus_2
%qdf                0:1 !function=plus_1

@3r                 ...... ..... vt:5 vs:5 vd:5 .... df:2      &r3
@3r_v               ...... ..... vt:5 vs:5 vd:5 ......         &r3 df=0
@3r_f               ...... ..... vt:5 vs:5 vd:5 ..... .        &r3 df=%fdf
@3r_q               ...... ..... vt:5 vs:5 vd:5 ..... .        &r3 df=%qdf
@2r                 ...... ..... ..... vs:5 vd:5 .... df:2     &r2
@2r_f               ...... ..... ..... vs:5 vd:5 ..... .       &r2 df=%fdf
@4r                 ...... vr:5 vt:5 vs:5 vd:5 ......          &r4
@i8                 ...... df:2 imm:8 vs:5 vd:5 ......         &i
@i8_b               ...... .. imm:8 vs:5 vd:5 ......           &i df=0
@i6                 ...... df:2 .. imm:6 vs:5 vd:5 ......      &i
@ldst               ...... base:5 offset:s10 vd:5 ......       &ldst
@ldst_a             ...... base:5 .......... vd:5 ......       &ldst offset=%ldst_a
@ldst_x             ...... base:5 index:5 ..... vd:5 ......    &ldst_x
@b                  ...... df:2 ... vs:5 offset:s10 ......     &b
@b_v                ...... .. ... vs:5 offset:s10 ......       &b df=4
@gpr                ...... df:2 imm:8 rt:5 vr:5 ......         &gpr
@insffpu            ...... ..... imm:5 ft:5 vr:5 ..... df:1    &fpr
@mtfpu              ...... ..... imm:5 vr:5 ft:5 ..... df:1    &fpr
@cr                 ...... ..... ..... rt:5 cr:5 ......        &cr

# SPECIAL2 major opcode

LU1QX               011100 ..... ..... 00000 ..... 000111      @ldst_x
SU1QX               011100 ..... ..... 00100 ..... 000111      @ldst_x
LA1QX               011100 ..... ..... 10000 ..... 000111      @ldst_x
SA1QX               011100 ..... ..... 10100 ..... 000111      @ldst_x
LI                  011100 imm:s15 vd:5 0011 df:2              &li
LU1Q                011100 ..... .......... ..... 010100       @ldst
SHUFV               011100 ..... ..... ..... ..... 011000      @4r
BSELV               011100 ..... ..... ..... ..... 011001      @4r
SU1Q                011100 ..... .......... ..... 011100       @ldst
BEQZ                011100 .. 000 ..... .......... 101000      @b
BNEZ                011100 .. 100 ..... .......... 101000      @b
BEQZ_V              011100 00 000 ..... .......... 101001      @b_v
BNEZ_V              011100 00 100 ..... .......... 101001      @b_v
LA1Q                011100 ..... .......... ..... 101100       @ldst_a
ANDIB               011100 00 ........ ..... ..... 110000      @i8_b
NORIB               011100 01 ........ ..... ..... 110000      @i8_b
ORIB                011100 10 ........ ..... ..... 110000      @i8_b
XORIB               011100 11 ........ ..... ..... 110000      @i8_b
INSFCPU             011100 .. ........ ..... ..... 110001      @gpr
INSFMXU             011100 .. ........ ..... ..... 110010      @i8
MTCPUS              011100 .. ........ ..... ..... 110011      @gpr
MTCPUU              011100 .. ........ ..... ..... 110100      @gpr
REPI                011100 .. ........ ..... ..... 110101      @i8
SATS                011100 .. 00 ...... ..... ..... 111000     @i6
SATU                011100 .. 01 ...... ..... ..... 111000     @i6
SLLI                011100 .. 10 ...... ..... ..... 111000     @i6
SRAI                011100 .. 00 ...... ..... ..... 111001     @i6
SRARI               011100 .. 01 ...... ..... ..... 111001     @i6
SRLI                011100 .. 10 ...... ..... ..... 111001     @i6
SRLRI               011100 .. 11 ...... ..... ..... 111001     @i6
SA1Q                011100 ..... .......... ..... 111100       @ldst_a

# COP2 major opcode, 3RINT-0

MAXA                010010 10000 ..... ..... ..... 0000 ..     @3r
MINA                010010 10000 ..... ..... ..... 0001 ..     @3r
MAXS                010010 10000 ..... ..... ..... 0010 ..     @3r
MINS                010010 10000 ..... ..... ..... 0011 ..     @3r
MAXU                010010 10000 ..... ..... ..... 0100 ..     @3r
MINU                010010 10000 ..... ..... ..... 0101 ..     @3r
SRA                 010010 10000 ..... ..... ..... 0110 ..     @3r
SRL                 010010 10000 ..... ..... ..... 0111 ..     @3r
SRAR                010010 10000 ..... ..... ..... 1000 ..     @3r
SRLR                010010 10000 ..... ..... ..... 1001 ..     @3r
CEQ                 010010 10000 ..... ..... ..... 1010 ..     @3r
CNE                 010010 10000 ..... ..... ..... 1011 ..     @3r
CLTS                010010 10000 ..... ..... ..... 1100 ..     @3r
CLTU                010010 10000 ..... ..... ..... 1101 ..     @3r
CLES                010010 10000 ..... ..... ..... 1110 ..     @3r
CLEU                010010 10000 ..... ..... ..... 1111 ..     @3r

# 3RINT-1

ADDA                010010 10001 ..... ..... ..... 0000 ..     @3r
SUBSA               010010 10001 ..... ..... ..... 0001 ..     @3r
ADDAS               010010 10001 ..... ..... ..... 0010 ..     @3r
SUBUA               010010 10001 ..... ..... ..... 0011 ..     @3r
ADDSS               010010 10001 ..... ..... ..... 0100 ..     @3r
SUBSS               010010 10001 ..... ..... ..... 0101 ..     @3r
ADDUU               010010 10001 ..... ..... ..... 0110 ..     @3r
SUBUU               010010 10001 ..... ..... ..... 0111 ..     @3r
ADD                 010010 10001 ..... ..... ..... 1000 ..     @3r
SUBUS               010010 10001 ..... ..... ..... 1001 ..     @3r
SLL                 010010 10001 ..... ..... ..... 1010 ..     @3r
SUB                 010010 10001 ..... ..... ..... 1011 ..     @3r
AVES                010010 10001 ..... ..... ..... 1100 ..     @3r
AVERS               010010 10001 ..... ..... ..... 1101 ..     @3r
AVEU                010010 10001 ..... ..... ..... 1110 ..     @3r
AVERU               010010 10001 ..... ..... ..... 1111 ..     @3r

# 3RINT-2

DIVS                010010 10010 ..... ..... ..... 0000 ..     @3r
MUL                 010010 10010 ..... ..... ..... 0001 ..     @3r
DIVU                010010 10010 ..... ..... ..... 0010 ..     @3r
MADD                010010 10010 ..... ..... ..... 0011 ..     @3r
MODS                010010 10010 ..... ..... ..... 0100 ..     @3r
MSUB                010010 10010 ..... ..... ..... 0101 ..     @3r
MODU                010010 10010 ..... ..... ..... 0110 ..     @3r
REPX                010010 10010 rt:5 vs:5 vd:5 0111 df:2
DOTPS               010010 10010 ..... ..... ..... 1000 ..     @3r
DADDS               010010 10010 ..... ..... ..... 1001 ..     @3r
DOTPU               010010 10010 ..... ..... ..... 1010 ..     @3r
DADDU               010010 10010 ..... ..... ..... 1011 ..     @3r
DSUBS               010010 10010 ..... ..... ..... 1101 ..     @3r
DSUBU               010010 10010 ..... ..... ..... 1111 ..     @3r

# 3RVEC

ANDV                010010 10110 ..... ..... ..... 111000      @3r_v
NORV                010010 10110 ..... ..... ..... 111001      @3r_v
ORV                 010010 10110 ..... ..... ..... 111010      @3r_v
XORV                010010 10110 ..... ..... ..... 111011      @3r_v

# 3RFP

FADD                010010 11000 ..... ..... ..... 00000 .     @3r_f
FSUB                010010 11000 ..... ..... ..... 00001 .     @3r_f
FMUL                010010 11000 ..... ..... ..... 00010 .     @3r_f
FDIV                010010 11000 ..... ..... ..... 00011 .     @3r_f
FMADD               010010 11000 ..... ..... ..... 00100 .     @3r_f
FMSUB               010010 11000 ..... ..... ..... 00101 .     @3r_f
VCVTHS              010010 11000 ..... ..... ..... 00110 0     @3r_v
VCVTSD              010010 11000 ..... ..... ..... 00110 1     @3r_v
VCVTQHS             010010 11000 ..... ..... ..... 00111 0     @3r_v
VCVTQWD             010010 11000 ..... ..... ..... 00111 1     @3r_v
FCOR                010010 11000 ..... ..... ..... 01000 .     @3r_f
FCEQ                010010 11000 ..... ..... ..... 01001 .     @3r_f
FCLT                010010 11000 ..... ..... ..... 01010 .     @3r_f
FCLE                010010 11000 ..... ..... ..... 01011 .     @3r_f
FMAX                010010 11000 ..... ..... ..... 01100 .     @3r_f
FMAXA               010010 11000 ..... ..... ..... 01101 .     @3r_f
FMIN                010010 11000 ..... ..... ..... 01110 .     @3r_f
FMINA               010010 11000 ..... ..... ..... 01111 .     @3r_f
MULQ                010010 11000 ..... ..... ..... 10100 .     @3r_q
MULQR               010010 11000 ..... ..... ..... 10101 .     @3r_q
MADDQ               010010 11000 ..... ..... ..... 11000 .     @3r_q
MADDQR              010010 11000 ..... ..... ..... 11001 .     @3r_q
MSUBQ               010010 11000 ..... ..... ..... 11010 .     @3r_q
MSUBQR              010010 11000 ..... ..... ..... 11011 .     @3r_q

# 2RINT

CEQZ                010010 11110 00000 ..... ..... 0000 ..     @2r
CNEZ                010010 11110 00000 ..... ..... 0001 ..     @2r
CLTZ                010010 11110 00000 ..... ..... 0010 ..     @2r
CLEZ                010010 11110 00000 ..... ..... 0011 ..     @2r
LOC                 010010 11110 00000 ..... ..... 0100 ..     @2r
LZC                 010010 11110 00000 ..... ..... 0101 ..     @2r
BCNT                010010 11110 00000 ..... ..... 1100 ..     @2r
MFCPU               010010 11110 00000 rt:5 vd:5 1111 df:2

# 2RFP

FSQRT               010010 11110 00001 ..... ..... 00000 .     @2r_f
FCLASS              010010 11110 00001 ..... ..... 00011 .     @2r_f
VCVTS               010010 11110 00001 ..... ..... 00100 .     @2r_f
VCVTU               010010 11110 00001 ..... ..... 00101 .     @2r_f
VCVTFS              010010 11110 00001 ..... ..... 00110 .     @2r_f
VCVTFU              010010 11110 00001 ..... ..... 00111 .     @2r_f
VTRUNCS             010010 11110 00001 ..... ..... 01010 .     @2r_f
VTRUNCU             010010 11110 00001 ..... ..... 01011 .     @2r_f
VCVTR               010010 11110 00001 ..... ..... 01110 .     @2r_f
VCVTE               010010 11110 00001 ..... ..... 10000 .     @2r_f
VCVTO               010010 11110 00001 ..... ..... 10100 .     @2r_f
VCVTQE              010010 11110 00001 ..... ..... 11000 .     @2r_f
VCVTQO              010010 11110 00001 ..... ..... 11100 .     @2r_f
CTCMXU              010010 11110 00001 ..... ..... 111100      @cr
CFCMXU              010010 11110 00001 ..... ..... 111101      @cr
MFFPU               010010 11110 00001 ft:5 vd:5 11111 df:1

# 2R5I

INSFFPU             010010 11111 ..... ..... ..... 00000 .     @insffpu
MTFPU               010010 11111 ..... ..... ..... 00010 .     @mtfpu
